# Contact address sent to Crossref. Optional but recommended in production:
# Crossref gives requests that identify themselves priority routing, and asks
# that automated clients provide a way to get in touch.
CROSSREF_MAILTO=

# Optional. Without a key, Google Books requests share a per-address daily
# quota and start returning HTTP 429 — which is why Open Library is the primary
# ISBN resolver and Google Books only the fallback.
GOOGLE_BOOKS_API_KEY=
