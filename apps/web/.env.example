# Base URL for the lookup functions. Empty string = same origin (the Vite dev
# proxy or a Vercel deployment where /api lives beside the static build).
VITE_API_BASE_URL=

# Where CSL styles and locales are fetched from when not already cached in
# IndexedDB. Defaults to the official CSL repo via jsDelivr.
VITE_CSL_STYLES_CDN=https://cdn.jsdelivr.net/gh/citation-style-language/styles@master
VITE_CSL_LOCALES_CDN=https://cdn.jsdelivr.net/gh/citation-style-language/locales@master
